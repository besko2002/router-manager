# Router web UI (the same credentials you use in the browser at https://192.168.1.1)
ROUTER_URL=https://192.168.1.1
ROUTER_USERNAME=
ROUTER_PASSWORD=

# Application owner login (use a unique password with at least 10 characters).
# Leave both blank to enable one-time POST /api/auth/setup instead.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
# Set a unique secret of at least 32 UTF-8 bytes outside local development.
APP_JWT_SECRET=
APP_JWT_EXPIRATION=PT12H

# PostgreSQL (default compose exposes it on loopback only)
DB_URL=jdbc:postgresql://localhost:5438/router
DB_USERNAME=router
DB_PASSWORD=router
POLL_INTERVAL=60s
TIMEZONE=Africa/Cairo
